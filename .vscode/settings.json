{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests", "test_vizinhancas.py"],
  "python.testing.cwd": "${workspaceFolder}",
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.exclude": {"**/__pycache__": true, "**/.pytest_cache": true},
  "search.exclude": {"**/.venv": true, "**/tmp": true},
  "terminal.integrated.env.windows": {"PYTHONUTF8": "1"},
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.latex.outDir": "%DIR%/build/latex",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.recipes": [
    {"name": "Projeto: pdflatex (duas passagens)", "tools": ["pdflatex-projeto", "pdflatex-projeto"]}
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex-projeto",
      "command": "pdflatex",
      "args": ["-synctex=1", "-interaction=nonstopmode", "-halt-on-error", "-file-line-error", "-output-directory=%OUTDIR%", "%DOC%"]
    }
  ]
}
